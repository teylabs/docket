{
    "name": "tey/docket",
    "description": "Package skeleton for tracking long-running Laravel work. In early development; no usable features yet.",
    "keywords": [
        "laravel",
        "queue",
        "progress"
    ],
    "homepage": "https://github.com/teylabs/docket",
    "license": "MIT",
    "authors": [
        {
            "name": "Jasper Tey",
            "email": "jasper@teylabs.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/teylabs/docket/issues",
        "source": "https://github.com/teylabs/docket"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "laravel/serializable-closure": "^2.0.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-multitenancy": "^4.0"
    },
    "suggest": {
        "spatie/laravel-multitenancy": "Carries the current tenant through work dispatched inside a transaction (^4.0)."
    },
    "autoload": {
        "psr-4": {
            "Tey\\Docket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tey\\Docket\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G",
            "vendor/bin/phpstan analyse -c phpstan.tests.neon.dist --memory-limit=1G"
        ],
        "test": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "check-docs": "@php scripts/check-llms.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tey\\Docket\\DocketServiceProvider"
            ]
        },
        "tey-standards": {
            "ci": {
                "default-branches": [
                    "main",
                    "*.x"
                ],
                "distribution": "package",
                "drafts": "full",
                "enforce": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
