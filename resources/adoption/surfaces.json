{
  "format": 1,
  "package": {
    "composer": "tey/docket"
  },
  "facts": [
    {
      "id": "has-queued-jobs",
      "description": "The app dispatches queued jobs: a class implements ShouldQueue, or the app already tracks runs through Docket.",
      "computed": {
        "signals": [
          {
            "kind": "php-class",
            "implements": [
              "Illuminate\\Contracts\\Queue\\ShouldQueue",
              "Tey\\Docket\\Docketable"
            ]
          },
          {
            "kind": "composer",
            "packages": [
              "tey/docket"
            ]
          }
        ]
      }
    }
  ],
  "surfaces": [
    {
      "id": "jobs.run-tracking",
      "layer": "backend",
      "group": "jobs",
      "label": "Run tracking for queued work",
      "feature": "core",
      "applies": "has-queued-jobs",
      "uses": {
        "classes": [
          "Tey\\Docket\\Docket",
          "Tey\\Docket\\Facades\\Docket",
          "Tey\\Docket\\Docketable",
          "Tey\\Docket\\HasRuns",
          "Tey\\Docket\\PendingRun",
          "Tey\\Docket\\Run",
          "Tey\\Docket\\Ticket"
        ]
      },
      "handRolled": [
        {
          "kind": "migration",
          "tables": [
            "job_statuses",
            "job_status",
            "job_progress",
            "job_runs",
            "job_logs",
            "import_logs",
            "export_logs",
            "imports",
            "exports",
            "batch_progress",
            "queue_monitor"
          ]
        },
        {
          "kind": "composer",
          "packages": [
            "imtigger/laravel-job-status",
            "romanzipp/laravel-queue-monitor",
            "croustibat/filament-jobs-monitor"
          ]
        },
        {
          "kind": "php-class",
          "names": [
            "*JobStatus",
            "*JobProgress",
            "*JobRun",
            "*ImportLog",
            "*ExportLog",
            "*TracksProgress"
          ]
        }
      ],
      "replaces": {
        "composer": [
          "imtigger/laravel-job-status",
          "romanzipp/laravel-queue-monitor",
          "croustibat/filament-jobs-monitor"
        ]
      },
      "docs": "docs/reference.md",
      "status": "stable"
    },
    {
